# CareerForge API — environment template
# Copy to .env and fill in real values. Never commit the filled-in .env.

NODE_ENV=development
PORT=5000

# MongoDB connection string
DATABASE_URL=mongodb://127.0.0.1:27017/careerforge

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend URL — used for password-reset links in emails
APP_BASE_URL=http://localhost:5173

# CORS — comma-separated list of allowed origins, or * for development
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Mail — SendGrid (preferred) or SMTP fallback
SENDGRID_API_KEY=
SENDGRID_FROM=verified-sender@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CareerForge <noreply@careerforge.dev>

# Sentry (optional — leave empty to disable)
SENTRY_DSN=
